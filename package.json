{
  "name": "latex-helper",
  "displayName": "LaTeX Helper",
  "description": "本地 LaTeX 辅助工具集合",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:latex"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "latex-helper.showFormulaPanel",
        "title": "Show Formula Panel"
      },
      {
        "command": "latex-helper.importSnippets",
        "title": "Import Snippets from latex-utilities"
      },
      {
        "command": "latex-helper.showFormulaBrowser",
        "title": "Show Formula Browser"
      },
      {
        "command": "latex-helper.setGroupMode",
        "title": "Set Group Mode"
      },
      {
        "command": "latex-helper.sympyEvaluate",
        "title": "SymPy: Evaluate Selection"
      },
      {
        "command": "latex-helper.sympyReplace",
        "title": "SymPy: Replace Selection with Result"
      },
      {
        "command": "latex-helper.sympyFactor",
        "title": "SymPy: Factor Selection"
      },
      {
        "command": "latex-helper.sympyExpand",
        "title": "SymPy: Expand Selection"
      },
      {
        "command": "latex-helper.sympyNumerical",
        "title": "SymPy: Numerical Evaluation (15 digits)"
      },
      {
        "command": "latex-helper.sympySolve",
        "title": "SymPy: Solve Equation in Selection"
      },
      {
        "command": "latex-helper.sympyEvalAt",
        "title": "SymPy: Evaluate at Point (expr|_{x=...})"
      },
      {
        "command": "latex-helper.sympyDefine",
        "title": "SymPy: Define Variable from Selection (name = expr)"
      },
      {
        "command": "latex-helper.sympyShowVars",
        "title": "SymPy: Show Defined Variables"
      },
      {
        "command": "latex-helper.sympyResetVars",
        "title": "SymPy: Reset Variables"
      }
    ],
    "keybindings": [
      {
        "command": "latex-helper.sympyEvaluate",
        "key": "ctrl+alt+shift+e",
        "mac": "ctrl+alt+shift+e",
        "when": "editorTextFocus && editorLangId == latex"
      },
      {
        "command": "latex-helper.sympyReplace",
        "key": "ctrl+alt+shift+r",
        "mac": "ctrl+alt+shift+r",
        "when": "editorTextFocus && editorLangId == latex"
      },
      {
        "command": "latex-helper.sympyFactor",
        "key": "ctrl+alt+shift+f",
        "mac": "ctrl+alt+shift+f",
        "when": "editorTextFocus && editorLangId == latex"
      },
      {
        "command": "latex-helper.sympyExpand",
        "key": "ctrl+alt+shift+x",
        "mac": "ctrl+alt+shift+x",
        "when": "editorTextFocus && editorLangId == latex"
      },
      {
        "command": "latex-helper.sympyNumerical",
        "key": "ctrl+alt+shift+n",
        "mac": "ctrl+alt+shift+n",
        "when": "editorTextFocus && editorLangId == latex"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "latex-helper",
          "title": "LaTeX Helper",
          "icon": "icons/icon.svg"
        }
      ]
    },
    "views": {
      "latex-helper": [
        {
          "id": "latex-helper.formulaPanel",
          "name": "Formula Panel",
          "type": "webview"
        },
        {
          "id": "latex-helper.groupModeTree",
          "name": "Group By"
        }
      ]
    },
    "configuration": {
      "title": "LaTeX Helper",
      "properties": {
        "latex-helper.snippets": {
          "type": "array",
          "default": [],
          "description": "LaTeX snippets for auto-completion"
        },
        "latex-helper.latexPath": {
          "type": "string",
          "default": "latex",
          "description": "Path to latex executable (DVI mode)"
        },
        "latex-helper.dvisvgmPath": {
          "type": "string",
          "default": "dvisvgm",
          "description": "Path to dvisvgm executable"
        },
        "latex-helper.sympyPythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Path to python3 with sympy installed (e.g. ~/.local/pipx/venvs/sympy/bin/python3 for pipx installs)"
        },
        "latex-helper.auxPath": {
          "type": "string",
          "default": "./temp",
          "description": "Relative path to directory containing auxiliary (.aux) files for reference detection"
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "eslint": "^8.56.0"
  }
}
